{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "niers",
  "version": "0.4.0",
  "identifier": "dev.niers.explorer",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "data",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "transparent": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["g4md", "g4mg", "g4sk", "g4mt", "g4tx", "g4pk", "g4ra", "g4pkm", "g4cm", "g4ma", "g4vs", "g4la", "g4nv"],
        "name": "Asset Level-5 (Inazuma Eleven: Victory Road)",
        "description": "Formats G4 du moteur Level-5 — ouvrir avec nie-explorer",
        "role": "Viewer"
      },
      {
        "ext": ["col", "objbin", "mevbin", "p3lip", "navm", "nxtch"],
        "name": "Asset Inazuma Eleven: Victory Road",
        "description": "Formats binaires du jeu — ouvrir avec nie-explorer",
        "role": "Viewer"
      },
      {
        "ext": ["vfxo", "pfxo", "cfxo", "gfxo"],
        "name": "Shader compilé (DXBC)",
        "description": "Shader DirectX du jeu — ouvrir avec nie-explorer",
        "role": "Viewer"
      }
    ]
  }
}
