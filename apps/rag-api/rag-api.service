[Unit]
Description=rag-api — recherche RAG locale (bun:sqlite, zero Supabase) pour api.rosegriffon.fr/rag/
After=network.target rg-rag-embed.service
Wants=rg-rag-embed.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/rg/apps/rag-api
Environment=PATH=/home/ubuntu/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=RAG_API_PORT=8806
Environment=RAG_API_HOST=127.0.0.1
Environment=RAG_EMBED_URL=http://127.0.0.1:8799
Environment=RAG_STORE_PATH=/home/ubuntu/rg/apps/azalee/data/rag/rag-store.sqlite
ExecStart=/home/ubuntu/.bun/bin/bun server.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
