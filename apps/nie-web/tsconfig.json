{
	"extends": "../../tsconfig.nie-base.json",
	"compilerOptions": {
		"noEmit": true,
		"declaration": false,
		"jsx": "react-jsx",
		"types": ["vite/client", "bun", "@webgpu/types"],
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"allowImportingTsExtensions": true,
		"moduleDetection": "force",
		"noUncheckedIndexedAccess": false,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/desktop/*"],
			"@nie/inacord-ui": ["./src/inacord/index.ts"],
			"@nie/inacord-ui/*": ["./src/inacord/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "scripts/**/*.ts", "vite.config.ts"]
}
