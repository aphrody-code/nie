{
	"name": "nie-web",
	"version": "0.1.0",
	"private": true,
	"description": "WebAssembly host for the nie engine, served by the nie-site crate.",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:desktop": "vite --mode desktop",
		"dev:inacord-web": "vite --mode inacord-web",
		"preview:desktop": "vite preview --mode desktop",
		"preview:inacord-web": "vite preview --mode inacord-web",
		"build:desktop": "bun run typecheck:desktop && vite build --mode desktop",
		"build:inacord-web": "bun run typecheck:desktop && tsc -b && vite build --mode inacord-web",
		"build": "bun run build:wasm && tsc -b && vite build && bun --bun scripts/precompress.ts",
		"build:wasm": "bun --bun scripts/build-wasm.ts",
		"preview": "vite preview",
		"typecheck": "bunx tsc --noEmit",
		"test": "bun test --preload ../../packages/nie-plugin/src/register.ts --preload ../../packages/nie-plugin/src/happydom.ts src/",
		"typecheck:desktop": "bunx tsc --noEmit -p tsconfig.desktop.json"
	},
	"dependencies": {
		"@aphrody/ietv-client": "workspace:*",
		"@monaco-editor/react": "catalog:",
		"@niers/asset-source": "workspace:*",
		"@niers/bridge": "workspace:*",
		"@niers/game": "workspace:*",
		"@niers/inacord-ui": "workspace:*",
		"@tauri-apps/api": "catalog:",
		"@tauri-apps/plugin-clipboard-manager": "catalog:",
		"@tauri-apps/plugin-dialog": "catalog:",
		"@tauri-apps/plugin-fs": "catalog:",
		"@tauri-apps/plugin-opener": "catalog:",
		"@tauri-apps/plugin-process": "catalog:",
		"@tauri-apps/plugin-updater": "catalog:",
		"lucide-react": "catalog:",
		"monaco-editor": "catalog:",
		"next-themes": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"sonner": "catalog:",
		"three": "catalog:",
		"tw-animate-css": "catalog:"
	},
	"devDependencies": {
		"@tailwindcss/vite": "catalog:",
		"@types/bun": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@types/three": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"@webgpu/types": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
