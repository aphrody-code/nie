{
	"name": "nie-web",
	"version": "1.0.0",
	"private": true,
	"description": "WebAssembly host for the nie engine, served by the nie-site crate.",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:desktop": "vite --mode desktop",
		"preview:desktop": "vite preview --mode desktop",
		"build:desktop": "bun run typecheck && vite build --mode desktop",
		"build": "bun run build:wasm && bun run build:wasm-viewer && bun run typecheck && tsc -b && bun --bun ./node_modules/.bin/vite build && bun --bun scripts/precompress.ts",
		"build:wasm": "bun --bun scripts/build-wasm.ts",
		"build:wasm-viewer": "bun --bun scripts/build-viewer-wasm.ts",
		"preview": "vite preview",
		"typecheck": "bunx tsc --noEmit",
		"test": "bun test --parallel=1 --isolate --max-concurrency 1 --preload ../../packages/nie-plugin/src/register.ts --preload ../../packages/nie-plugin/src/happydom.ts src/ scripts/"
	},
	"dependencies": {
		"@base-ui/react": "catalog:",
		"@monaco-editor/react": "catalog:",
		"@nie/asset-source": "workspace:*",
		"@nie/bridge": "workspace:*",
		"@nie/game": "workspace:*",
		"@radix-ui/react-accordion": "catalog:",
		"@radix-ui/react-alert-dialog": "catalog:",
		"@radix-ui/react-aspect-ratio": "catalog:",
		"@radix-ui/react-avatar": "catalog:",
		"@radix-ui/react-checkbox": "catalog:",
		"@radix-ui/react-context-menu": "catalog:",
		"@radix-ui/react-dialog": "catalog:",
		"@radix-ui/react-dropdown-menu": "catalog:",
		"@radix-ui/react-hover-card": "catalog:",
		"@radix-ui/react-label": "catalog:",
		"@radix-ui/react-menubar": "catalog:",
		"@radix-ui/react-navigation-menu": "catalog:",
		"@radix-ui/react-radio-group": "catalog:",
		"@radix-ui/react-slot": "catalog:",
		"@radix-ui/react-toggle": "catalog:",
		"@rosegriffon/ui": "catalog:",
		"@tanstack/react-table": "catalog:",
		"@tauri-apps/api": "catalog:",
		"@tauri-apps/plugin-clipboard-manager": "catalog:",
		"@tauri-apps/plugin-dialog": "catalog:",
		"@tauri-apps/plugin-fs": "catalog:",
		"@tauri-apps/plugin-opener": "catalog:",
		"@tauri-apps/plugin-process": "catalog:",
		"@tauri-apps/plugin-updater": "catalog:",
		"class-variance-authority": "catalog:",
		"clsx": "catalog:",
		"cmdk": "catalog:",
		"date-fns": "catalog:",
		"embla-carousel-react": "catalog:",
		"input-otp": "catalog:",
		"lucide-react": "catalog:",
		"monaco-editor": "catalog:",
		"next-themes": "catalog:",
		"nie-media": "workspace:*",
		"react": "catalog:",
		"react-day-picker": "catalog:",
		"react-dom": "catalog:",
		"react-hook-form": "catalog:",
		"react-resizable-panels": "catalog:",
		"recharts": "catalog:",
		"sonner": "catalog:",
		"tailwind-merge": "catalog:",
