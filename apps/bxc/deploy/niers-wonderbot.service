[Unit]
# Wonderbot — bot Discord du catalogue d'épisodes, servi depuis niers.
#
# Reprend `bxc-wonderbot.service` à l'identique, à trois choses près :
#   • WorkingDirectory=/home/ubuntu/niers et non /home/ubuntu/bxc ;
#   • le point d'entrée est `apps/bxc/src/cli.ts` du dépôt, pas le binaire
#     compilé /usr/local/bin/bxc ;
#   • l'environnement vit dans ~/.config/niers/wonderbot.env, hors dépôt.
#
# ── UN SEUL BOT SUR LE JETON ───────────────────────────────────────────────
# Deux processus connectés au MÊME jeton Discord se partagent les interactions
# au hasard : une commande sur deux resterait sans réponse, et les annonces
# partiraient en double. `bxc-wonderbot` doit être arrêté ET désactivé avant
# d'activer celui-ci.
#
# Installation :
#   sudo cp apps/bxc/deploy/niers-wonderbot.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now niers-wonderbot
Description=Wonderbot — bot Discord du catalogue d'episodes (niers)
Documentation=file:///home/ubuntu/niers/apps/bxc/README.md
After=network-online.target
Wants=network-online.target

# Jamais de plafond de redémarrages : le défaut systemd (5 en 10 s puis abandon
# définitif) transformerait une coupure réseau de quelques minutes en bot
# éteint jusqu'à intervention humaine.
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/niers

# Le jeton Discord vit ICI, jamais dans le dépôt (chmod 600, hors arborescence
# git). Le `-` initial rend le fichier facultatif : sans lui, `lireConfig`
# refuse de démarrer avec un message qui dit quelle variable poser.
EnvironmentFile=-/home/ubuntu/.config/niers/wonderbot.env
Environment=NODE_ENV=production

# `PATH` est OBLIGATOIRE : systemd n'en fournit pas qui contienne
# /home/ubuntu/.bun/bin.
Environment=PATH=/home/ubuntu/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Catalogue partagé avec `niers-bxc workflow` et `niers-bxc wonderbot refresh`.
# Le chemin est posé explicitement parce que `ProtectHome=` plus bas ne rend
# accessible en écriture que ce répertoire précis : SQLite en mode WAL écrit
# des fichiers voisins (-wal, -shm), une base « lue seulement » ne suffit pas.
Environment=IETV_CACHE_PATH=/home/ubuntu/.cache/ietv/episodes.db

# `--bun` force le runtime Bun même si un paquet transitif porte un shebang
# `#!/usr/bin/env node` : `node` est proscrit dans ce dépôt.
ExecStart=/home/ubuntu/.bun/bin/bun --bun /home/ubuntu/niers/apps/bxc/src/cli.ts wonderbot start

# `always` : une déconnexion Discord qui se solde par une sortie en code 0
# n'était jamais relancée — le bot restait silencieux sans qu'aucune unité ne
# soit en échec.
Restart=always
RestartSec=15

# 130 = SIGINT/SIGTERM traité proprement par la CLI. C'est une sortie normale,
# pas un échec : sinon `systemctl stop` laisse l'unité en failed.
SuccessExitStatus=130

# 77 = configuration refusée (jeton absent, identifiant d'application invalide).
# Relancer ne répare rien, et marteler la passerelle avec un mauvais jeton est
# le meilleur moyen de faire limiter l'application par Discord.
RestartPreventExitStatus=77

TimeoutStopSec=20s
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=niers-wonderbot

# ── Limites de ressources ──
# Le bot ne tient que la passerelle et une base SQLite ; le rafraîchissement,
# lui, scrape sept sources toutes les six heures — d'où la marge.
MemoryMax=1G
MemoryHigh=768M
TasksMax=512
CPUWeight=100
Nice=5
OOMScoreAdjust=-200

# ── Durcissement (MemoryDenyWriteExecute INTERDIT — casse le JIT de Bun) ──
ProtectSystem=strict
ProtectHome=read-only
# Le catalogue est la SEULE chose que le service écrit sous $HOME. Sans cette
# ligne, ProtectHome=read-only rendrait l'ouverture SQLite EROFS et le bot
# planterait au premier `/episodes`.
ReadWritePaths=/home/ubuntu/.cache/ietv /tmp
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
NoNewPrivileges=true
RemoveIPC=true
# `PrivateDevices` et `RestrictNamespaces` ne sont PAS posés : le balayage
# `iecrawl` peut lancer un moteur de rendu, qui a besoin de /dev/shm et de ses
# espaces de noms pour son bac à sable.

[Install]
WantedBy=multi-user.target
