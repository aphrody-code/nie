# nie (nie.aphrody.com) — servi par la crate `nie-site`, 100 % Rust, sur 127.0.0.1:8085.
#
# NE PAS INSTALLER depuis cette session : l'installation, le `daemon-reload` et le `reload`
# nginx sont des actes de production (J5 du PLAN, propriétaire Codex, avec le go de
# l'utilisateur). Ce fichier décrit ce qui doit tourner ; il ne le fait pas tourner.
#
#   sudo cp deploy/systemd/nie-site.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now nie-site
#   curl -s http://127.0.0.1:8085/healthz | jq .        # doit répondre "nie-site"
#
# Rollback : `git revert` sur `deploy/nginx/aphrody.com.conf`, puis `nginx -t` et reload.
# PAS « repointer sur :8083 » : `aphrody-site` est inactif et desactive, rien n'y ecoute, et
# ce repli rendrait des 502. Carte mesuree : `docs/HOSTS-AND-PORTS.md`.

[Unit]
Description=nie-site — nie (bundle nie-web, /api/v1, espaces VFS /f et /b, proxy nie-model-serve)
Documentation=https://nie.aphrody.com/docs/stack/web-platform
After=network.target
# Le proxy /assets dégrade proprement quand l'amont est absent (502/504) : la dépendance est
# souhaitée, pas requise — nie-site doit pouvoir démarrer et répondre /healthz sans lui.
Wants=nie-model-serve.service
After=nie-model-serve.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/
ExecStart=/bin/sh -c 'exec "$NIE_REPO_ROOT/target/release/nie-site" \
    --listen 127.0.0.1:8085 \
    --db ${NIE_REPO_ROOT}/var/mirror.sqlite \
    --upstream http://127.0.0.1:8790 \
    --bundle-dir ${NIE_REPO_ROOT}/apps/nie-web/dist \
    --origin https://nie.aphrody.com'

# Le VFS se monte en tâche de fond : le processus écoute et répond /healthz immédiatement,
# et /f + /b passent de 503 à 200 quand l'index des ~255 000 entrées est construit.
#
# ── LE JEU, PAS LE DÉPÔT (corrigé 2026-09-19) ──────────────────────────────
# Cette ligne a désigné `/home/ubuntu/niers` depuis la création de l'unité. Le
# dépôt ne contient AUCUN CPK — `data/` est gitignore par obligation légale —
# et le VFS s'y rabattait sur un dump : `/healthz` annonçait alors
# `vfs_entrees: 156873` et `vfs_cpks: 0`, contre les ~255 000 que le
# commentaire ci-dessus décrit déjà comme la cible.
#
# L'effet mesuré était un ÉCRAN NOIR sur tout le site, jamais une erreur : les
# `.objbin` des calques de menu ne vivent que dans les CPK, donc
# `/api/v1/menu/layout/<ecran>` répondait 200 avec 100 % de ses calques
# manquants. `chara_edit_menu` 13 déclarés / 13 manquants / 0 sprite,
# `chara_bank_menu` 34 / 34 / 0, `main_menu` 13 / 13 / 0. La même instance
# lancée sur l'install Steam donne 13 / 0 / 13, 34 / 9 / 25 et 13 / 1 / 12.
# Un layout qui n'a rien à dessiner rend une page vide, pas un 500 — d'où des
# mois possibles sans que rien ne soit en échec.
#
# Même racine que `--game-dir` de `nie-model-serve`, qui lui l'a toujours eue.
# Override NIE_REPO_ROOT in /etc/nie/nie.env on hosts that use another checkout.
Environment=NIE_REPO_ROOT=/home/ubuntu/niers
Environment=NIE_GAME_DIR=/home/ubuntu/.local/share/Steam/iecode/inazuma
EnvironmentFile=-/etc/nie/nie.env
Environment=RUST_LOG=info
# Budget du cache de CPK de nie-formats. La machine sert déjà nie-model-serve avec 8 GiB :
# nie-site ne lit que des fichiers, il n'assemble rien — 2 GiB suffisent.
Environment=NIE_CPK_CACHE_BUDGET_GIB=6

Restart=always
RestartSec=5s
# La vitrine et ses espaces VFS restent prioritaires face aux décodages et tâches
# IA/batch en cas de contention. Poids relatifs, sans quota ni réservation rigide.
CPUWeight=1000
IOWeight=1000
# Plafond mémoire : au-delà, systemd tue le service plutôt que de laisser earlyoom choisir
# une victime au hasard sur une machine qui porte 18 autres services.
MemoryMax=10G
MemoryHigh=8G
LimitNOFILE=16384

# Durcissement : le service ne fait que LIRE des fichiers et parler à 127.0.0.1.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
# Aucun chemin en écriture : nie-site n'écrit rien sur disque (le cache est en mémoire).
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
