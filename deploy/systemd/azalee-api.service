[Unit]
# Legacy Azalee API listener. The implementation is the native Rust `nie-site`
# binary; no Bun wiki server is used in production.
#
# The listener keeps port 8807 for already deployed clients while the canonical
# site listener remains on 8085. Both listeners read the same local mirror and
# the same VFS-backed data root.
Description=Azalee API compatibility listener (nie-site, Rust, read-only)
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/niers
Environment=PATH=/home/ubuntu/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=AZALEE_PORT=8807
Environment=AZALEE_HOST=127.0.0.1
# Pinned mirror — the same source as the canonical nie-site listener.
Environment=SQLITE_DB_PATH=/home/ubuntu/niers/var/mirror.sqlite
Environment=AZALEE_DATA_DIR=/home/ubuntu/niers/data/azalee
Environment=NIE_GAME_DIR=/home/ubuntu/niers
Environment=RUST_LOG=info
ExecStart=/home/ubuntu/niers/target/release/nie-site \
    --listen 127.0.0.1:8807 \
    --db /home/ubuntu/niers/var/mirror.sqlite \
    --upstream http://127.0.0.1:8790 \
    --bundle-dir /home/ubuntu/niers/apps/nie-web/dist \
    --origin https://nie.aphrody.com
Restart=always
RestartSec=5

# Plafond mémoire. Le 14/8/2026, huit unités de production tournaient en
# MemoryMax=infinity : une fuite dans n'importe laquelle d'entre elles pouvait épuiser
# les 45 Gio de l'hôte, et c'est l'OOM killer GLOBAL qui tranchait — il a tué
# nie-model-serve à 02h16 ce jour-là, mais le prochain choisi aurait pu être le wiki.
# Un plafond par service transforme une panne d'hôte en panne d'un seul service, que
# Restart= répare seul. Mesuré ici : 38 Mio de working set.
MemoryHigh=1G
MemoryMax=2G
MemorySwapMax=256M

# Lecture seule : le service n'écrit que ses SQLite matérialisés en tmpfs.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=false
ReadWritePaths=/tmp
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
