[Unit]
# rg-storage — API Storage compatible Supabase, servie depuis `niers/apps/storage`.
#
# The service runs from `niers/apps/storage`. Its historical unit name remains stable because
# systemd watchers and nginx reference it; the name is not a data-source boundary. This service is
# the self-hosted storage compatibility layer for editorial uploads; game data is owned by Rust
# and is never served from this process. The unit name is referenced by
# `rg-watchdog@rg-storage.timer` and nginx; renaming it would break monitoring without changing
# the data boundary. No path may point to `/home/ubuntu/rg`.
#
# Secrets stay outside the repository with mode 600: `/etc/rg-storage.env`.
#
# Installation:
#   sudo cp deploy/systemd/rg-storage.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl restart rg-storage.service
Description=rg-storage — API Storage compatible Supabase (Bun, fichiers locaux, depuis niers)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/niers
EnvironmentFile=/etc/rg-storage.env
ExecStart=/home/ubuntu/.bun/bin/bun --bun /home/ubuntu/niers/apps/storage/server.ts
Restart=always
RestartSec=2

# Plafond mémoire (raisonnement complet dans azalee-api.service). Mesuré : 38 Mio.
# Un envoi de fichier passe en flux, sans être bufferisé entièrement en mémoire — d'où
# un plafond bas assumé : s'il est atteint, c'est que ce n'est plus vrai.
MemoryHigh=512M
MemoryMax=1G
MemorySwapMax=256M
ProtectSystem=full
ReadWritePaths=/var/www/rg-storage /tmp
PrivateTmp=true

[Install]
WantedBy=multi-user.target
