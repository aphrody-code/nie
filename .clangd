CompileFlags:
  CompilationDatabase: build/msvc
  Add:
    - -std=c++20
    # Chemins relatifs a la racine du depot : l'arbre C++ vit sous src/ depuis
    # le regroupement du 2026-08-11 (les anciens chemins absolus C:/Users/... du
    # depot iecode d'origine ne resolvaient plus rien ici).
    - -Isrc/include
    - -Ithird_party/stb
    - -Ithird_party/bcdec
    - -Ithird_party/xxhash
    - -Ithird_party/concurrentqueue
    - -Ithird_party/mio
    - -DNOMINMAX
    - -DUNICODE
    - -D_WIN32_WINNT=0x0A00
