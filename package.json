{
	"name": "nie-monorepo",
	"version": "1.0.0",
	"private": true,
	"description": "Bun workspace for nie libraries and applications; the `nie` name is reserved for the FFI package.",
	"workspaces": {
		"packages": [
			"apps/inacord",
			"apps/nie-web",
			"packages/asset-source",
			"packages/inacord-ui",
			"packages/nie",
			"packages/nie-bridge",
			"packages/nie-game",
			"packages/nie-media"
		],
		"catalog": {
			"@base-ui/react": "^1.7.0",
			"@happy-dom/global-registrator": "^20.10.1",
			"@hookform/resolvers": "^5.4.0",
			"@monaco-editor/react": "^4.7.0",
			"@radix-ui/react-accordion": "^1.2.12",
			"@radix-ui/react-alert-dialog": "^1.1.15",
			"@radix-ui/react-aspect-ratio": "^1.1.8",
			"@radix-ui/react-avatar": "^1.1.11",
			"@radix-ui/react-checkbox": "^1.3.3",
			"@radix-ui/react-collapsible": "^1.1.12",
			"@radix-ui/react-context-menu": "^2.2.16",
			"@radix-ui/react-dialog": "^1.1.15",
			"@radix-ui/react-dropdown-menu": "^2.1.16",
			"@radix-ui/react-hover-card": "^1.1.15",
			"@radix-ui/react-label": "^2.1.8",
			"@radix-ui/react-menubar": "^1.1.16",
			"@radix-ui/react-navigation-menu": "^1.2.14",
			"@radix-ui/react-popover": "^1.1.15",
			"@radix-ui/react-progress": "^1.1.8",
			"@radix-ui/react-radio-group": "^1.3.8",
			"@radix-ui/react-scroll-area": "^1.2.10",
			"@radix-ui/react-select": "^2.2.6",
			"@radix-ui/react-separator": "^1.1.8",
			"@radix-ui/react-slider": "^1.3.6",
			"@radix-ui/react-slot": "^1.2.4",
			"@radix-ui/react-switch": "^1.2.6",
			"@radix-ui/react-tabs": "^1.1.13",
			"@radix-ui/react-toggle": "^1.1.10",
			"@radix-ui/react-toggle-group": "^1.1.11",
			"@radix-ui/react-tooltip": "^1.2.8",
			"@supabase/ssr": "^0.10.3",
			"@supabase/supabase-js": "^2.107.0",
			"@tailwindcss/vite": "^4.3.3",
			"@tanstack/react-table": "^8.21.3",
			"@tauri-apps/api": "^2",
			"@tauri-apps/cli": "^2",
			"@tauri-apps/plugin-clipboard-manager": "^2.3.2",
			"@tauri-apps/plugin-dialog": "^2.7.2",
			"@tauri-apps/plugin-fs": "^2.5.1",
			"@tauri-apps/plugin-opener": "^2",
			"@tauri-apps/plugin-process": "^2",
			"@tauri-apps/plugin-updater": "^2",
			"@types/bun": "1.3.14",
			"@types/node": "^25.9.1",
			"@types/pg": "^8.20.0",
			"@types/react": "^19.2.18",
			"@types/react-dom": "^19.2.4",
			"@types/three": "^0.185.4",
			"@vitejs/plugin-react": "^4.7.0",
			"@webgpu/types": "^0.1.70",
			"class-variance-authority": "^0.7.1",
			"clsx": "^2.1.1",
			"cmdk": "^1.1.1",
			"date-fns": "^4.4.0",
			"embla-carousel-react": "^8.6.0",
			"input-otp": "^1.4.2",
			"kysely": "^0.29.2",
			"lucide-react": "^1.29.0",
			"monaco-editor": "^0.56.0",
			"next": "16.3.0-canary.37",
			"next-themes": "^0.4.6",
			"oxlint": "^1.68.0",
			"pg": "^8.21.0",
			"qrcode-generator": "^2.0.4",
			"react": "^19.2.8",
			"react-day-picker": "^10.0.1",
			"react-dom": "^19.2.8",
			"react-hook-form": "^7.77.0",
			"react-resizable-panels": "^4.11.2",
			"recharts": "^3.8.1",
			"sonner": "^2.0.7",
			"tailwind-merge": "^3.6.0",
			"tailwindcss": "^4.3.3",
			"three": "^0.185.1",
			"tw-animate-css": "^1.4.0",
			"typescript": "5.9.3",
			"vaul": "^1.1.2",
			"vite": "^6.4.3",
			"vitest": "^4.1.8",
			"wanakana": "^5.3.1",
			"zod": "^4.4.3"
		}
	},
	"type": "module",
	"scripts": {
		"build:ffi": "cargo build -p nie-ffi",
		"build:web": "bun run --cwd apps/nie-web build",
		"measure:rust-web": "bun --bun scripts/validation/measure-rust-web-coverage.ts",
		"validate:shared-capabilities": "bun --bun scripts/validation/validate-shared-capabilities.ts",
		"generate:public-entry-inventory": "bun --bun scripts/validation/generate-public-entry-inventory.ts",
		"build": "bun run --filter '*' build",
		"test": "bun run --filter '*' test && bun run test:scripts",
		"test:scripts": "bun test scripts/",
		"typecheck": "bun run --filter '*' typecheck",
		"typecheck:scripts": "bunx tsc -p scripts/tsconfig.gate.json --noEmit",
		"lint": "bunx oxlint -c .oxlintrc.json -A style -A pedantic -A restriction packages apps",
		"lint:fix": "bunx oxlint -c .oxlintrc.json -A style -A pedantic -A restriction --fix packages apps",
		"release:all": "bun scripts/release-all.ts",
		"release:inacord": "bun scripts/release-inacord.ts",
		"deploy:target": "bun scripts/deploy-target.ts",
		"docs:check": "bun run scripts/docs/check.ts",
		"check:dependencies": "uv run --no-project python scripts/validation/dependency-owners.py",
		"check:layers": "bun --bun scripts/validation/layers.ts",
		"surfaces": "bun run scripts/surfaces.ts",
		"gate": "bun run scripts/surfaces.ts gate",
		"audit:monorepo": "bun run check:dependencies && bun run check:layers && cargo deny check advisories bans licenses sources && bun run generate:public-entry-inventory && bun run validate:shared-capabilities"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "catalog:",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"pg": "catalog:",
		"typescript": "catalog:"
	},
	"overrides": {
		"kysely": "0.28.17"
	},
	"engines": {
		"bun": ">=1.4.2"
	},
	"packageManager": "bun@1.4.2"
}
