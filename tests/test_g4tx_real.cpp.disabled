protected:
    void SetUp() override {
        data_ = read_file(test_data_dir() / "em0001.g4tx");
        has_data_ = !data_.empty();
    }
    std::vector<uint8_t> data_;
    bool has_data_ = false;
};

TEST_F(G4txEmblemTest, Parse512) {
    if (!has_data_) GTEST_SKIP();
    auto result = iecode::level5::g4tx_parse(data_);
    ASSERT_TRUE(result.has_value());
    ASSERT_EQ(result->textures.size(), 1u);
    EXPECT_EQ(result->textures[0].width, 512);
    EXPECT_EQ(result->textures[0].height, 512);
}

TEST_F(G4txEmblemTest, DecodeRGBA) {
    if (!has_data_) GTEST_SKIP();
    auto result = iecode::level5::g4tx_parse(data_);
