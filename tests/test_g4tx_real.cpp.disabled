// ── Batch : parser tous les fichiers test data ─────────────────────

TEST(G4txBatch, ParseAllTestFiles) {
    const auto dir = test_data_dir();
    if (!fs::exists(dir)) GTEST_SKIP();
    int ok = 0;
    for (const auto& entry : fs::directory_iterator(dir)) {
        if (entry.path().extension() != ".g4tx") continue;
        auto data = read_file(entry.path());
        auto result = iecode::level5::g4tx_parse(data);
        EXPECT_TRUE(result.has_value()) << entry.path().filename().string();
        if (result) {
            for (const auto& tex : result->textures) {
                auto rgba = iecode::converters::decode_to_rgba8(tex);
                EXPECT_FALSE(rgba.empty()) << entry.path().filename().string();
            }
            ++ok;
        }
    }
    EXPECT_GT(ok, 0);
}
