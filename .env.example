# Copy this file to .env.local only on a new machine. On an already configured
# Nie host, run `bash scripts/install-shell-environment.sh`; it merges the
# private files from ~/.config/nie without printing their values.

# Repository and installed game (non-secret)
NIE_REPO=/absolute/path/to/nie
NIE_REPO=/absolute/path/to/nie
NIE_GAME_DIR=/absolute/path/to/Steam/iecode/inazuma
IEVR_GAME_DIR=/absolute/path/to/Steam/iecode/inazuma
NIE_GAME_PATH=/absolute/path/to/Steam/iecode/inazuma
STEAM_LIBRARY_PATH=/absolute/path/to/Steam
NIE_RUNTIME_BASE=/absolute/path/to/share/nie/runtime
NIE_STEAM_APP_ID=2799860
NIE_STEAM_DEPOT=2799861
NIE_STEAM_TOKEN_STORE=/absolute/path/to/share/nie/steam-tokens.json
STEAM_TOKEN_STORE=/absolute/path/to/share/nie/steam-tokens.json
STEAM_COMPAT_CLIENT_INSTALL_PATH=/absolute/path/to/Steam
STEAM_COMPAT_DATA_PATH=/absolute/path/to/share/nie/runtime/proton-prefix
WINEPREFIX=/absolute/path/to/share/nie/runtime/proton-prefix/pfx
NIE_DISPLAY=:99
NIE_RES=1280x720
SteamAppId=2799860
SteamGameId=2799860

# Local data and caches (non-secret)
