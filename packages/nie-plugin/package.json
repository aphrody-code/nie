{
	"name": "nie-plugin",
	"version": "1.0.0",
	"description": "Bun plugin — importe les formats de jeu IEVR (.g4tx, .cfg.bin, .objbin, .g4pkm, .lip, .mev, .g4md) et expose nie:re/* (artefacts RE + Lua décompilé)",
	"type": "module",
	"main": "src/index.ts",
	"module": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": {
			"import": "./src/index.ts",
			"types": "./src/index.ts"
		},
		"./register": {
			"import": "./src/register.ts",
			"types": "./src/register.ts"
		}
	},
	"files": ["src/index.ts", "src/register.ts", "src/happydom.ts", "README.md"],
	"license": "MIT",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "bunx tsc --noEmit"
	},
	"dependencies": {
		"@aphrody/nie": "workspace:*"
	},
	"devDependencies": {
		"typescript": "catalog:",
		"@types/bun": "catalog:"
	}
}
