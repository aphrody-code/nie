{
  "name": "@niers/catalog",
  "version": "0.1.0",
  "description": "Catalogue SQLite du VFS IEVR — index des 250k assets via bun:sqlite, requêtes byExt/search/stats",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "index": "bun run src/index.ts"
  },
  "dependencies": {
    "nie": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/bun": "catalog:"
  }
}
