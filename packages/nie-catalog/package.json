{
	"name": "@niers/catalog",
	"version": "0.1.0",
	"description": "Façade unique des quatre gisements Inazuma Eleven du dépôt : le jeu (VFS/CDN), les données extraites (inagle_*), le reverse (niers.sqlite) et l'anime (épisodes IETV).",
	"type": "module",
	"private": true,
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./sources": "./src/sources.ts",
		"./excerpt": "./src/excerpt.ts",
		"./extrait": "./src/extrait.ts",
		"./re": "./src/re.ts",
		"./game": "./src/game.ts",
		"./jeu": "./src/jeu.ts",
		"./anime": "./src/anime.ts",
		"./synergy": "./src/synergy.ts",
		"./synergie": "./src/synergie.ts"
	},
	"scripts": {
		"typecheck": "bunx tsc --noEmit",
		"test": "bun test --timeout 20000"
	},
	"devDependencies": {
		"typescript": "catalog:",
		"@types/bun": "catalog:"
	},
	"license": "Apache-2.0"
}
