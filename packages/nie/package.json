{
  "name": "nie",
  "version": "0.4.0",
  "description": "Bindings FFI des deux bibliothèques natives de niers — nie_ffi (Rust) et iecode_ffi (C++)",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./iecode": {
      "import": "./src/iecode.ts",
      "types": "./src/iecode.ts"
    },
    "./backend": {
      "import": "./src/backend.ts",
      "types": "./src/backend.ts"
    }
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/bun": "catalog:"
  }
}
