	"dependencies": {
		"runtime": {
			"@leeoniya/ufuzzy": "^1.0.14",
			"next": "^16.0.0",
			"react": "^19.0.0"
		},
		"dev": {
			"vitest": "^2.0.0",
			"typescript": "^5.0.0"
		},
		"newDependencies": false
	},

	"performance": {
		"cache_hit": "<1ms",
		"simple_search": "5-10ms",
		"fuzzy_search": "15-30ms",
		"levenshtein_100": "~2ms",
		"highlighting": "<1ms",
		"cache_hit_rate": "~60%",
		"debounce_reduction": "~80%"
	},

	"api": {
		"fuzzy_match": [
			"levenshteinDistance(a: string, b: string): number",
			"similarityScore(a: string, b: string): number",
			"isSimilar(a: string, b: string, threshold?: number): boolean",
			"normalizeText(text: string): string",
			"findClosestMatch(query: string, candidates: string[], threshold?: number): Match | null",
			"getNameVariations(names: Names): string[]",
			"detectMatchedLanguage(query: string, names: Names): Language | null",
			"highlightMatches(text: string, query: string): HighlightPart[]"
		],
		"smart_search": [
			"smartSearch(query: string, rawResults: GlobalSearchResult[], config?: SmartSearchConfig): Promise<SmartSearchResult[]>",
			"clearSearchCache(): void",
			"getCacheStats(): CacheStats"
		],
		"server_actions": [
			"searchGlobal(query: string, context?: SearchContext): Promise<EnhancedSearchResult[]>",
			"getSearchSuggestions(query: string): Promise<string[]>"
		]
	},

	"types": [
		"SmartSearchResult",
		"SmartSearchConfig",
		"SearchContext",
		"EnhancedSearchResult",
		"HighlightPart",
		"CacheStats",
		"Match"
	],

	"contexts": ["chara", "skill", "aura", "passive", "team", "global"],

	"languages": ["FR", "EN", "JP"],

	"materialDesign3": {
		"tokens": [
			"--md-sys-color-primary",
			"--md-sys-color-on-surface",
			"--md-sys-color-secondary-container",
			"--md-sys-color-tertiary-container",
			"--md-sys-motion-duration-short2",
			"--md-sys-motion-duration-short4",
			"--md-sys-motion-easing-standard",
			"--md-sys-state-hover-state-layer-opacity"
		],
		"components": [
			"Filled Tonal Button",
			"Modal Dialog",
			"Filled Text Field",
			"List Item (three-line)",
			"Assist Chip",
			"Emphasis Mark",
			"Placeholder Skeleton",
			"Empty State",
			"Outlined Button"
		],
		"icons": [
			"search",
			"search_off",
			"lightbulb",
			"person",
			"person_outline",
			"sports_soccer",
			"auto_awesome",
			"star",
			"arrow_forward"
		]
	},

	"configuration": {
		"debounce_ms": 300,
		"cache_ttl_ms": 300000,
		"cache_max_size": 100,
		"fuzzy_threshold": 0.7,
		"suggestion_threshold": 0.6,
		"result_limit": 15,
		"query_min_length": 2
	},

	"roadmap": {
		"v1.1.0": [
			"Search history (localStorage)",
			"Advanced keyboard shortcuts",
			"Export results (JSON/CSV)",
			"Search analytics"
		],
		"v1.2.0": [
			"Advanced filters (element, position, stats)",
			"Regex support",
			"Stats range search"
		],
		"v2.0.0": [
			"Voice search (Web Speech API)",
			"AI-powered suggestions (OpenAI)",
			"Image search",
			"Semantic search (embeddings)"
		]
	},

	"accessibility": {
		"wcag_level": "AAA",
		"contrast_ratios": {
			"on_surface": "12.3:1",
			"on_primary": "8.2:1",
			"on_surface_variant": "7.1:1"
		},
		"keyboard_support": true,
		"screen_reader_support": true,
		"touch_target_size": "48x48dp"
	},

	"testing": {
