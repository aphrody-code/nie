{
	"extends": "../config/tsconfig-base.json",
	"compilerOptions": {
		"noEmit": true,
		"declaration": false,
		// This package imports workspace TypeScript sources directly (not `dist`),
		// so they are checked with this package's options.
		// Sans cet alignement, tsc rapporte les erreurs d'un autre paquet.
		"noUncheckedIndexedAccess": false,
		"types": ["bun"],
		"lib": ["ESNext"],
		"allowImportingTsExtensions": true,
		"baseUrl": ".",
		"moduleDetection": "force"
	},
	"include": ["src/**/*.ts", "test/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
