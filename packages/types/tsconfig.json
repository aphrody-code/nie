{
	"extends": "@rosegriffon/config/tsconfig-base.json",
	"compilerOptions": {
		"outDir": "dist",
		"noEmit": true,
		"declaration": false,
		"baseUrl": ".",
		"ignoreDeprecations": "5.0",
		"rootDir": "..",
		"paths": {
			"@rosegriffon/db": ["../db/src/index.ts"],
			"@rosegriffon/db/*": ["../db/src/*"]
		}
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
